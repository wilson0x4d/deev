{
    "connections": {
        "clickhouse_test": "Server=127.0.0.1:8192;Database=clickhouse_test;Uid=test_usr;Pwd=test_user;Provider=clickhouse;ENGINE=Replicated('/clickhouse/databases/{database}', '{shard}', '{replica}');cluster=default",
        "mongo_test": "Server=127.0.0.1:27017;Database=mongo_test;Uid=test_usr;Pwd=test_user;Provider=pymongo",
        "mysql_test": "Server=127.0.0.1:3306;Database=mysql_test;Uid=test_usr;Pwd=test_user;Provider=mysql.connector",
        "sqlite_test": "Server=test_data/sqlite/;Database=edge.db;Provider=sqlite3"
    },
    "logging": {
        "level": "DEBUG",
        "format": "[%(asctime)s] %(message)s level=\"%(levelname)s\" source=\"%(name)s\" func=\"%(funcName)s\" %(metadata)s",
        "datefmt": "%Y-%m-%dT%H:%M:%S",
        "handlers": [
            {
                "type": "console",
                "level": "DEBUG"
            }
        ],
        "filters": {
            "asyncio": {
                "level": "WARNING"
            },
            "mysql.connector.*": {
                "level": "WARNING"
            },
            "deev.mongodb.*": {
                "level": "WARNING"
            },
            "deev.mysql..*": {
                "level": "WARNING"
            },
            "deev.sqlite..*": {
                "level": "WARNING"
            },
            "pymongo.*": {
                "level": "WARNING"
            }
        }
    }
}
